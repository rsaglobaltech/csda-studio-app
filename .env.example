# Copy one environment file to `.env` or set `APP_ENV` before running Docker Compose.
APP_ENV=dev
PROJECT_SLUG=csda-studio-app

DATABASE_ENGINE=postgres
DATABASE_IMAGE=postgres:16
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_CONTAINER_PORT=5432
DATABASE_NAME=csda_studio_app_dev
DATABASE_USER=csda_studio_app_app
DATABASE_PASSWORD=change-me
DATABASE_URL=postgresql://csda_studio_app_app:change-me@db:5432/csda_studio_app_dev

POSTGRES_DB=csda_studio_app_dev
POSTGRES_USER=csda_studio_app_app
POSTGRES_PASSWORD=change-me
